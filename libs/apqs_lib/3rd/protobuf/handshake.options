# HandshakeRequest
# ML-KEM-768 raw key (1184 B) + SPKI/DER overhead: SEQUENCE, AlgorithmIdentifier OID, BIT STRING (~22 B) = 1206 B, +4 B buffer slack
handshake.HandshakeRequest.epk_sender_pqc        max_size:1210
handshake.HandshakeRequest.epk_sender_ec         max_size:46
handshake.HandshakeRequest.cipher_init_rekey     max_size:1088
handshake.HandshakeRequest.ocspresp_mcs          max_size:10240

# HandshakeResponse
handshake.HandshakeResponse.cipher_rekey_resp1   max_size:1088
handshake.HandshakeResponse.cipher_rekey_resp2   max_size:1088
handshake.HandshakeResponse.epk_replier_ec       max_size:46
handshake.HandshakeResponse.tag_replier          max_size:48

# HandshakeKeyConfirmation
handshake.HandshakeKeyConfirmation.tag_sender    max_size:48

# Oneof fields: nanopb must know the maximum size of every message inside
handshake.HandshakeMessage.request          type:FT_INLINE
handshake.HandshakeMessage.response         type:FT_INLINE
handshake.HandshakeMessage.keyconfirmation  type:FT_INLINE