# Certificates and OCSP responses are DER; 10240 covers ML-DSA-87 certs (~9.2 KB)
pki.InitTrust.cert_ca           max_size:10240
# Pre-shared secret: 256-bit minimum, 832-bit (104 B) optimum
pki.InitTrust.pss_sat           max_size:128

# CertificationRequestInfo DER with ML-KEM-768 SPKI (~1.9 KB) + slack
pki.CsrRequest.csr              max_size:2400
# HMAC-SHA3-384 tag
pki.CsrRequest.mac              max_size:48

pki.NewCertificate.cert_sat     max_size:10240

pki.CertExchange.cert_mcs       max_size:10240
pki.CertExchange.ocsp_resp_mcs  max_size:10240

pki.CertSat.cert_sat            max_size:10240

pki.PkiStatus.detail            max_size:64

# Oneof fields: nanopb must know the maximum size of every message inside
pki.PkiMessage.init_trust       type:FT_INLINE
pki.PkiMessage.renew_cert       type:FT_INLINE
pki.PkiMessage.csr_request      type:FT_INLINE
pki.PkiMessage.new_certificate  type:FT_INLINE
pki.PkiMessage.cert_exchange    type:FT_INLINE
pki.PkiMessage.cert_sat_request type:FT_INLINE
pki.PkiMessage.cert_sat         type:FT_INLINE
pki.PkiMessage.status           type:FT_INLINE
